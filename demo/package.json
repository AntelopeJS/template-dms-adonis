{
  "name": "template-dms-demo",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "scripts": {
    "prepare": "tsc",
    "build": "rimraf dist && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && pnpm --dir frontend-vue lint",
    "format": "oxfmt . && pnpm --dir frontend-vue format",
    "format:check": "oxfmt --check .",
    "knip": "knip --workspace . --dependencies",
    "test": "pnpm run build && node --test \"dist/**/*.test.js\" && pnpm --dir frontend-vue test"
  },
  "dependencies": {
    "@antelopejs/interface-api": "^0.3.0",
    "@antelopejs/interface-core": "^0.4.0",
    "@antelopejs/interface-data-api": "^0.6.1",
    "@antelopejs/interface-database": "^0.3.1",
    "@antelopejs/interface-database-decorators": "^0.2.1",
    "@antelopejs/interface-dms": "^0.12.0",
    "@antelopejs/interface-dms-automation": "^0.6.1",
    "@antelopejs/interface-dms-mailing": "^0.10.0",
    "@antelopejs/interface-dms-marketing": "^0.6.0",
    "@antelopejs/interface-dms-media": "^0.3.2",
    "@antelopejs/interface-dms-saas": "^0.7.0"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": "^0.5.0",
    "@types/node": "^26.6.5",
    "knip": "^6.41.0",
    "oxfmt": "^0.77.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2004",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    }
  },
  "dmsFrontend": "dist/frontend-module.js"
}
