{
  "name": "template-dms-demo",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "scripts": {
    "prepare": "antelopejs-tsc",
    "build": "rimraf dist && antelopejs-tsc",
    "typecheck": "antelopejs-tsc --noEmit && antelopejs-tsc -p frontend-vue && antelopejs-tsc -p frontend-vue/tests",
    "lint": "oxlint --type-aware --max-warnings=0 && pnpm --dir frontend-vue lint",
    "format": "oxfmt . && pnpm --dir frontend-vue format",
    "format:check": "oxfmt --check .",
    "knip": "knip --workspace . --dependencies",
    "test": "pnpm run build && node --test \"dist/**/*.test.js\" && pnpm --dir frontend-vue test"
  },
  "dependencies": {
    "@antelopejs/interface-api": "^0.3.3",
    "@antelopejs/interface-core": "^0.5.1",
    "@antelopejs/interface-data-api": "^0.8.0",
    "@antelopejs/interface-database": "^0.4.0",
    "@antelopejs/interface-database-decorators": "^0.5.2",
    "@antelopejs/interface-dms": "^0.14.6",
    "@antelopejs/interface-dms-automation": "^0.7.2",
    "@antelopejs/interface-dms-mailing": "^0.11.2",
    "@antelopejs/interface-dms-marketing": "^0.7.1",
    "@antelopejs/interface-dms-media": "^0.4.1",
    "@antelopejs/interface-dms-saas": "^0.10.2"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": ">=0.8.9 <0.9.0",
    "@types/node": "^26.6.6",
    "knip": "^6.46.1",
    "oxfmt": "^0.77.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2007",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3"
  },
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    }
  },
  "dmsFrontend": "dist/frontend-module.js"
}
