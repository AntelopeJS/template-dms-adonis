{
	"name": "template-dms-demo-frontend-vue",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "./dms.frontend.ts",
	"packageManager": "pnpm@10.2.0",
	"engines": {
		"@antelopejs/dms-frontend": ">=0.11.8 <0.12.0"
	},
	"scripts": {
		"prepare": "ajs dms prepare-types --out .dms-types",
		"dev": "pnpm --dir ../.. frontend:dev",
		"build": "pnpm --dir ../.. frontend:build",
		"format": "prettier --write .",
		"lint": "node scripts/check-locales.ts && eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run"
	},
	"dependencies": {
		"entities": "^8.1.0",
		"marked": "^17.0.6",
		"vue": "^3.5.45"
	},
	"devDependencies": {
		"@nuxt/ui": "4.13.0",
		"@types/node": "^26.6.6",
		"@vitejs/plugin-vue": "^6.0.11",
		"eslint": "^10.15.0",
		"eslint-plugin-vue": "^10.12.1",
		"jsdom": "^30.1.3",
		"prettier": "^3.10.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
