{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["node", "vite/client"],
		"strict": true,
		"noEmit": true,
		"allowJs": true,
		"checkJs": true,
		"resolveJsonModule": true
	},
	"include": ["**/*.ts", "**/*.mjs"],
	"exclude": ["node_modules", "dist"]
}
