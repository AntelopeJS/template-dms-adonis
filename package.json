{
  "name": "template-dms-adonis",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "frontend:dev": "ajs dms dev -p 3001",
    "frontend:build": "cross-env NODE_ENV=production ajs dms build",
    "frontend:start": "cross-env NODE_ENV=production ajs dms start -p 3001",
    "test": "node ace test",
    "lint": "oxlint",
    "format": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync --profile template",
    "sync:check": "antelopejs-sync --check --profile template",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "dependencies": {
    "@adonisjs/core": "^6.18.0",
    "@antelopejs/api": "^1.3.4",
    "@antelopejs/auth-jwt": "^1.0.3",
    "@antelopejs/core": "^1.16.0",
    "@antelopejs/dms": ">=0.9.2 <1.0.0",
    "@antelopejs/dms-api": ">=0.4.0 <1.0.0",
    "@antelopejs/dms-automation": ">=0.4.0 <1.0.0",
    "@antelopejs/dms-database": ">=0.2.0 <1.0.0",
    "@antelopejs/dms-media": ">=0.4.0 <1.0.0",
    "@antelopejs/file-storage-local": "^0.1.8",
    "@antelopejs/mongodb": "^1.4.2",
    "@antelopejs/nodemailer": "^0.0.5",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@adonisjs/eslint-plugin": "^2.2.2",
    "@adonisjs/tsconfig": "^1.4.0",
    "@antelopejs/dms-frontend": ">=0.6.1 <0.7.0",
    "@antelopejs/tooling-configs": "^0.2.12",
    "@japa/assert": "^4.0.1",
    "@japa/plugin-adonisjs": "^4.0.0",
    "@japa/runner": "^4.2.0",
    "@swc/core": "1.11.24",
    "@types/node": "^22.15.18",
    "cross-env": "^10.1.0",
    "hot-hook": "^0.4.0",
    "knip": "^6.43.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pino-pretty": "^13.0.0",
    "ts-node-maintained": "^10.9.5",
    "typescript": "~5.8"
  },
  "packageManager": "pnpm@10.2.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core"
    ]
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  }
}
