{
  "name": "template-dms-adonis",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "pnpm --dir demo build && node ace build",
    "dev": "pnpm --dir demo build && node ace serve --hmr",
    "frontend:dev": "ajs dms dev -p 3001",
    "frontend:build": "cross-env NODE_ENV=production ajs dms build",
    "frontend:start": "cross-env NODE_ENV=production ajs dms start -p 3001",
    "test": "pnpm --dir demo test && node ace test",
    "lint": "oxlint --disable-nested-config && pnpm --dir demo lint",
    "format": "oxfmt . && pnpm --dir demo format",
    "typecheck": "tsc --noEmit && pnpm --dir demo typecheck",
    "format:check": "oxfmt --check . && pnpm --dir demo format:check",
    "knip": "knip --workspace . && pnpm --dir demo knip",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync --profile template",
    "sync:check": "antelopejs-sync --check --profile template",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update",
    "demo:sync": "scripts/sync-demo.sh"
  },
  "dependencies": {
    "@adonisjs/core": "^7.6.0",
    "@antelopejs/api": "^1.7.1",
    "@antelopejs/auth-jwt": "^1.1.0",
    "@antelopejs/core": "^1.21.1",
    "@antelopejs/dms": ">=0.18.0 <1.0.0",
    "@antelopejs/dms-api": ">=0.6.2 <1.0.0",
    "@antelopejs/dms-automation": ">=0.9.1 <1.0.0",
    "@antelopejs/dms-database": ">=0.4.2 <1.0.0",
    "@antelopejs/dms-lang": ">=0.5.1 <1.0.0",
    "@antelopejs/dms-mailing": ">=0.9.0 <1.0.0",
    "@antelopejs/dms-marketing": ">=0.9.0 <1.0.0",
    "@antelopejs/dms-media": ">=0.7.1 <1.0.0",
    "@antelopejs/dms-saas": ">=0.10.0 <1.0.0",
    "@antelopejs/file-storage-local": "^0.2.0",
    "@antelopejs/mongodb": "^1.6.3",
    "@antelopejs/nodemailer": "^0.0.8",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/eslint-plugin": "^2.2.2",
    "@adonisjs/tsconfig": "^2.0.0",
    "@antelopejs/dms-frontend": ">=0.10.0 <0.11.0",
    "@antelopejs/tooling-configs": "^0.3.5",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.4.0",
    "@poppinss/ts-exec": "^1.5.1",
    "@types/node": "^24.0.0",
    "cross-env": "^10.1.0",
    "hot-hook": "^1.0.0",
    "knip": "^6.44.1",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pino-pretty": "^13.2.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@10.2.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "sharp"
    ]
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  }
}
